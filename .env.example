# ── Nyx instance config ──────────────────────────────────────────────
# Copy to .env and fill in. `.env` is gitignored; this template ships.

# System identity. The configurable name of THIS agent instance — rename your
# install by changing it (code reads `config.systemName`, never a hardcoded
# "Nyx"). The first var by convention. Renaming the on-disk dir / binary /
# launchd labels is a separate install step; this is the runtime/display name.
NAME=nyx

# ── Paths (optional) ─────────────────────────────────────────────────
# Scripts self-locate and the dispatcher derives its root from the source tree,
# so set these only if you run Nyx from a non-standard location.
# NYX_REPO_ROOT=
# NYX_DATA_DIR=

# ── Operator + commit identity ───────────────────────────────────────
# Set GIT_AUTHOR_* to YOUR real, GitHub-linked name + email, or commits Nyx
# makes won't attribute to your account and some CI providers will reject them.
OPERATOR_NAME=Operator
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# ── Model compute / auth ─────────────────────────────────────────────
# Spawn-auth mode is chosen at first-run: BYO key (set this) OR inherit the
# host's local Claude Max-plan OAuth (leave empty).
ANTHROPIC_API_KEY=

# ── GitHub ───────────────────────────────────────────────────────────
GITHUB_TOKEN=

# ── Slack notifications (optional — Nyx runs fine without) ───────────
SLACK_BOT_TOKEN=
SLACK_USER_ID=
SLACK_WEBHOOK_URL=

# ── Pushover notifications (optional second channel — Bitwarden-backed) ─
# A second push channel alongside Slack. Read like the Slack creds (env or the
# project's Bitwarden secrets); both empty → Pushover stays disabled regardless
# of the settings.notifications.channels.pushover flag. Per-category Pushover
# priority is set server-side (action-required punches through quiet hours).
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# ── Bitwarden Secrets Manager (optional) ─────────────────────────────
# BITWARDEN_MACHINE_TOKEN_PATH=~/.config/bitwarden/nyx-machine.token
# BITWARDEN_ORGANIZATION_ID=

# ── Tuning (optional; sensible defaults live in code) ────────────────
# AUTO_CHAIN=true
# MAX_CHAIN_DEPTH=2
# PIPELINE_CODER_CONCURRENCY=4
# DISPATCH_INTERVAL_MINUTES=15
# CLAUDE_PERMISSION_MODE=acceptEdits
# ── Type-aware concurrency (Track 3) ─────────────────────────────────
# ISO-pool size per tick (analysis/assistant/content run concurrently). [1,6]
# MAX_CONCURRENT_ISO=2
# Aggregate live-spawn ceiling across both classes (the one GIT task + ISO pool
# + a pipeline's coders). effectiveIsoCap = min(MAX_CONCURRENT_ISO, this-live). [1,12]
# MAX_CONCURRENT_CLAUDE=4
# Cooldown after a 429/overload signal (ms) when no Retry-After is given.
# RATE_LIMIT_COOLDOWN_MS=300000
# Per-launch jitter (ms) so N ISO spawns don't hit the API in the same instant.
# ISO_LAUNCH_JITTER_MS=500
