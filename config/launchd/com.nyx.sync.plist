<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nyx.sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NYX_ROOT__/scripts/nyx-sync.sh</string>
    <string>fg</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__NYX_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>NYX_REPO_ROOT</key>
    <string>__NYX_ROOT__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- Both stdout and stderr land in the same logfile that nyx-sync.sh writes to.
       Single source of truth — `tail -f logs/sync.log` works regardless of launcher. -->
  <key>StandardOutPath</key>
  <string>__NYX_ROOT__/logs/sync.log</string>

  <key>StandardErrorPath</key>
  <string>__NYX_ROOT__/logs/sync.log</string>

  <key>ProcessType</key>
  <string>Background</string>

  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
