<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nyx.dispatcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>__NYX_REPO_ROOT__/scripts/nyx-dispatch.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__NYX_REPO_ROOT__</string>

    <!-- 5-minute cadence: pipeline runs resume within one tick of a gate
         decision. The 96-slot grid stays 15 min via the tasksFiredInWindow
         dedup, so the extra ticks only advance pipeline + standing tasks. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>5</integer></dict>
        <dict><key>Minute</key><integer>10</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>20</integer></dict>
        <dict><key>Minute</key><integer>25</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>35</integer></dict>
        <dict><key>Minute</key><integer>40</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
        <dict><key>Minute</key><integer>50</integer></dict>
        <dict><key>Minute</key><integer>55</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__NYX_DATA_DIR__/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>__NYX_DATA_DIR__/logs/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__NYX_HOME__</string>
        <key>NYX_REPO_ROOT</key>
        <string>__NYX_REPO_ROOT__</string>
        <key>NYX_DATA_DIR</key>
        <string>__NYX_DATA_DIR__</string>
        <key>NYX_PLUGINS_DIR</key>
        <string>__NYX_PLUGINS_DIR__</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
